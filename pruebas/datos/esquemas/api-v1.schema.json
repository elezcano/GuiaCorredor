                  {
                    "type": "object",
                    "required": [
                      "evidencia",
                      "publicado",
                      "actualizado",
                      "validacion",
                      "verificacion",
                      "nivel"
                    ],
                    "properties": {
                      "fuente": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "required": [
                          "id",
                          "nombre",
                          "url",
                          "tipo"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "nombre": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "tipo": {
                            "type": "string"
                          }
                        }
                      },
                      "evidencia": {
                        "$ref": "comun.schema.json#/$defs/evidencia"
                      },
                      "validacion": {
                        "$ref": "comun.schema.json#/$defs/validacion"
                      },
                      "verificacion": {
                        "$ref": "comun.schema.json#/$defs/verificacion"
                      },
                      "nivel": {
                        "enum": [
                          "verificado",
                          "por-verificar",
                          "caducado",
                          "borrador"
                        ]
                      }
                    }
                  },
                  {
                    "required": [
                      "id",
                      "tipo",
                      "estado",
                      "descripcion"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "calendario": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "api",
            "version",
            "generado",
            "recurso",
            "registros"
          ],
          "properties": {
            "api": {
              "const": "v1"
            },
            "version": {
              "$ref": "comun.schema.json#/$defs/version"
            },
            "recurso": {
              "const": "calendario"
            }
          }
        },
        {
          "properties": {
            "registros": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "festivos",
                  "horariosPorPaso",
                  "regla"
                ]
              }
            }
          }
        }
      ]
    },
    "empresas": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "api",
            "version",
            "generado",
            "recurso",
            "registros"
          ],
          "properties": {
            "api": {
              "const": "v1"
            },
            "version": {
              "$ref": "comun.schema.json#/$defs/version"
            },
            "recurso": {
              "const": "empresas"
            }
          }
        },
        {
          "properties": {
            "registros": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "type": "object",
                    "required": [
                      "evidencia",
                      "publicado",
                      "actualizado",
                      "validacion",
                      "verificacion",
                      "nivel"
                    ],
                    "properties": {
                      "fuente": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "required": [
                          "id",
                          "nombre",
                          "url",
                          "tipo"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "nombre": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "tipo": {
                            "type": "string"
                          }
                        }
                      },
                      "evidencia": {
                        "$ref": "comun.schema.json#/$defs/evidencia"
                      },
                      "validacion": {
                        "$ref": "comun.schema.json#/$defs/validacion"
                      },
                      "verificacion": {
                        "$ref": "comun.schema.json#/$defs/verificacion"
                      },
                      "nivel": {
                        "enum": [
                          "verificado",
                          "por-verificar",
                          "caducado",
                          "borrador"
                        ]
                      }
                    }
                  },
                  {
                    "required": [
                      "id",
                      "nombre",
                      "sede",
                      "cobertura"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "fuentes": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "api",
            "version",
            "generado",
            "recurso",
            "registros"
          ],
          "properties": {
            "api": {
              "const": "v1"
            },
            "version": {
              "$ref": "comun.schema.json#/$defs/version"
            },
            "recurso": {
              "const": "fuentes"
            }
          }
        },
        {
          "properties": {
            "registros": {
              "type": "array",
              "items": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "id",
                  "nombre",
                  "url",
                  "tipo"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "nombre": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "tipo": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "organismos": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "api",
            "version",
            "generado",
            "recurso",
            "registros"
          ],
          "properties": {
            "api": {
              "const": "v1"
            },
            "version": {
              "$ref": "comun.schema.json#/$defs/version"
            },
            "recurso": {
              "const": "organismos"
            }
          }
        },
        {
          "properties": {
            "registros": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "type": "object",
                    "required": [
                      "evidencia",
                      "publicado",
                      "actualizado",
                      "validacion",
                      "verificacion",
                      "nivel"
                    ],
                    "properties": {
                      "fuente": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "required": [
                          "id",
                          "nombre",
                          "url",
                          "tipo"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "nombre": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "tipo": {
                            "type": "string"
                          }
                        }
                      },
                      "evidencia": {
                        "$ref": "comun.schema.json#/$defs/evidencia"
                      },
                      "validacion": {
                        "$ref": "comun.schema.json#/$defs/validacion"
                      },
                      "verificacion": {
                        "$ref": "comun.schema.json#/$defs/verificacion"
                      },
                      "nivel": {
                        "enum": [
                          "verificado",
                          "por-verificar",
                          "caducado",
                          "borrador"
                        ]
                      }
                    }
                  },
                  {
                    "required": [
                      "id",
                      "pais",
                      "url"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
